{
  "name": "pm-groundwork-mcp",
  "version": "3.0.0",
  "description": "MCP server for PM Groundwork \u2014 cross-tool PM workspace management for Claude Code, Codex, Cursor, and Gemini CLI",
  "author": {
    "name": "Jackie Romero",
    "url": "https://github.com/zoiestar/pm-groundwork"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "pm-groundwork-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build:prompts": "node scripts/build-prompts.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "prebuild": "npm run build:prompts",
    "build": "tsc",
    "prepublishOnly": "npm run build && npm run check:parity",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node scripts/test-protocol.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "mcp",
    "pm",
    "project-management",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli"
  ]
}
